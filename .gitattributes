# Merge policy for files where upstream's version should always win
# during automated upstream sync. The "theirs" driver is defined by the
# sync workflow (.github/workflows/sync_upstream.yml) and by anyone who
# wants the same behavior locally:
#
#   git config merge.theirs.name "always take theirs"
#   git config merge.theirs.driver "cp -f %B %A"
#
# Anything not listed here falls back to the normal 3-way merge.

# Shell scripts must keep LF line endings — they run on Linux runners.
*.sh                                                             text eol=lf

# Cargo / pnpm lock files — regenerated from manifests
Cargo.lock                                                       merge=theirs
**/pnpm-lock.yaml                                                merge=theirs

# tshy build outputs — regenerated by `tshy`
**/.tshy/*.json                                                  merge=theirs

# Generated TypeScript API clients (OpenAPI codegen)
npm-packages/@convex-dev/platform/src/generatedDeploymentApi.ts  merge=theirs
npm-packages/@convex-dev/platform/src/generatedLogStreamApi.ts   merge=theirs
npm-packages/@convex-dev/platform/src/generatedManagementApi.ts  merge=theirs
npm-packages/convex/src/cli/generatedApi.ts                      merge=theirs
npm-packages/convex/src/cli/lib/generatedFunctionLogsApi.ts      merge=theirs
