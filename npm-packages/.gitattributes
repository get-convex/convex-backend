# Don't allow people to merge changes to these generated files, because the result
# may be invalid.  You need to run "just update-js" again.
#
# Fork divergence: upstream uses merge=ours here, but an upstream sync must take
# upstream's lockfile — the sync script regenerates it afterwards to re-add this
# fork's extra workspace packages (dashboard-orchestrator).
pnpm-lock.yaml               merge=theirs
shrinkwrap.yaml              merge=ours
npm-shrinkwrap.json          merge=ours
yarn.lock                    merge=ours

# Some JSON config files (e.g. common-versions.json) use JavaScript-style code comments.  The rule
# below prevents pedantic syntax highlighters such as GitHub's from highlighting these comments as
# errors.  Your text editor may also require a special configuration to allow comments in JSON.
#
*.json                       linguist-language=JSON-with-Comments
