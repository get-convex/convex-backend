# syntax=docker/dockerfile:1-labs
# Builds dashboard-orchestrator (the platform UI: login, teams, projects,
# deployments, deploy keys). Targets the dashboard-orchestrator package
# and exposes :6793.
#
# Unlike Dockerfile.dashboard we skip `rush-pnpm deploy` and copy Next.js's
# standalone output directly. pnpm deploy's "publishable files only" pass
# strips `.next/` (it's gitignored), which silently breaks self-hosted
# orchestrator builds. The canonical Next.js standalone pattern copies
# `.next/standalone` + `.next/static` + `public` from the build stage.

FROM ubuntu:noble AS build

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates build-essential

# Install Node.js from the version pinned in .nvmrc.
COPY .nvmrc /nvmrc
RUN <<EOF
RAW=$(sed -E 's/[^0-9.]//g' /nvmrc)
NODE_MAJOR=$(echo "${RAW}" | cut -d. -f1)
curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash -
apt-get install -y --no-install-recommends nodejs="${RAW}-1nodesource1"
EOF

RUN --mount=type=cache,target=/root/.npm npm install -g @microsoft/rush@5
WORKDIR /app
COPY ./npm-packages ./npm-packages
WORKDIR /app/npm-packages/dashboard-orchestrator
# `rush update` instead of `rush install` so the build doesn't fail on a
# stale lock file when we add new deps (e.g. @headlessui/react) — the host
# regenerates better, but this lets the Docker build self-bootstrap when the
# host's `rush update` has Windows-specific bin-link issues.
RUN rush update
ENV NODE_ENV=production
# Build-time public env var pinning. Runtime overrides (NEXT_PUBLIC_*) only
# work for vars read inside `getServerSideProps`/runtime API routes; the
# values inlined into the client bundle are baked here.
ARG NEXT_PUBLIC_CONVEX_ORCHESTRATOR_URL=http://localhost:8050
ARG NEXT_PUBLIC_SELF_HOSTED_DASHBOARD_URL=http://localhost:6791
ENV NEXT_PUBLIC_CONVEX_ORCHESTRATOR_URL=${NEXT_PUBLIC_CONVEX_ORCHESTRATOR_URL}
ENV NEXT_PUBLIC_SELF_HOSTED_DASHBOARD_URL=${NEXT_PUBLIC_SELF_HOSTED_DASHBOARD_URL}
RUN rush build -t dashboard-orchestrator

# Stage the entire standalone tree at /opt/runtime. In a Next.js monorepo
# standalone build, the traced node_modules sits at .next/standalone/ (the
# root) while server.js lands under .next/standalone/<workspace-rel-path>/.
# Copying only the server.js subdir misses node_modules → "Cannot find
# module 'next'" at runtime. We copy the whole tree and record the
# subpath so the runtime entrypoint can `cd` into it.
WORKDIR /app/npm-packages/dashboard-orchestrator
RUN <<EOF
set -e
if [ ! -d .next/standalone ]; then
  echo "FATAL: next build did not emit .next/standalone"
  ls -la .next 2>/dev/null || echo "  (no .next directory either)"
  exit 1
fi
mkdir -p /opt/runtime
cp -a .next/standalone/. /opt/runtime/
# Locate server.js (excluding any nested node_modules copies).
SERVER=$(find /opt/runtime -name server.js -not -path '*/node_modules/*' | head -1)
if [ -z "$SERVER" ]; then
  echo "FATAL: standalone tree has no server.js"
  find /opt/runtime -maxdepth 4 -print | head -50
  exit 1
fi
APPDIR=$(dirname "$SERVER")
# Static + public assets live alongside server.js in the standalone
# runtime. Put them next to wherever server.js actually landed.
mkdir -p "$APPDIR/.next"
cp -a .next/static "$APPDIR/.next/static"
if [ -d public ]; then
  cp -a public "$APPDIR/public"
fi
# Record the runtime app subdir (relative to /opt/runtime). Empty string
# means "flat" layout; otherwise something like
# "npm-packages/dashboard-orchestrator".
REL=${APPDIR#/opt/runtime}
REL=${REL#/}
printf '%s' "$REL" > /opt/runtime/.appdir
EOF

FROM ubuntu:noble

COPY .nvmrc /nvmrc
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates
RUN <<EOF
RAW=$(sed -E 's/[^0-9.]//g' /nvmrc)
NODE_MAJOR=$(echo "${RAW}" | cut -d. -f1)
curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash -
apt-get install -y --no-install-recommends nodejs="${RAW}-1nodesource1"
EOF

RUN groupadd --system --gid 1001 nodejs
RUN useradd --system --uid 1001 --gid nodejs nextjs
COPY --from=build --chown=nextjs:nodejs /opt/runtime/ /app/
WORKDIR /app
USER nextjs
EXPOSE 6793
ENV PORT=6793
ENV HOSTNAME=0.0.0.0
# /app/.appdir is "" (flat layout) or the workspace-relative path to the
# app (nested monorepo layout). Either way the standalone root is /app
# and Node's module resolution walks up from the app dir into /app/
# node_modules.
CMD ["sh", "-c", "cd /app/\"$(cat /app/.appdir)\" && exec node server.js"]
