# syntax=docker/dockerfile:1-labs
# Builds dashboard-orchestrator (the platform UI: login, teams, projects,
# deployments, deploy keys). Mirrors Dockerfile.dashboard exactly except
# for the target package, port (6793), and the build-time NEXT_PUBLIC_*
# overrides.

FROM ubuntu:noble AS build

# Install deps
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates build-essential

# Install Node.js from NodeSource repository
# We extract the version from .nvmrc
COPY .nvmrc /nvmrc
RUN <<EOF
# Extract major version (e.g., "18" from "18.x.x")
NODE_MAJOR=$(cat /nvmrc | cut -d. -f1 | tr -d 'v\n')
# Add NodeSource repository and its signing key
curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash -
# Install the specific version listed in the nvmrc file
NODE_VERSION=$(cat /nvmrc | tr -d 'v\n')
apt-get install -y --no-install-recommends nodejs=${NODE_VERSION}-1nodesource1
EOF

RUN --mount=type=cache,target=/root/.npm npm install -g @microsoft/rush@5
WORKDIR /app
COPY ./npm-packages ./npm-packages
# Install dependencies and build
WORKDIR /app/npm-packages/dashboard-orchestrator
RUN rush install
ENV NODE_ENV=production
# Build-time public env var pinning. Runtime overrides (NEXT_PUBLIC_*) only
# work for vars read inside `getServerSideProps`/runtime API routes; the
# values inlined into the client bundle are baked here.
ARG NEXT_PUBLIC_CONVEX_ORCHESTRATOR_URL=http://localhost:8050
ARG NEXT_PUBLIC_SELF_HOSTED_DASHBOARD_URL=http://localhost:6791
ENV NEXT_PUBLIC_CONVEX_ORCHESTRATOR_URL=${NEXT_PUBLIC_CONVEX_ORCHESTRATOR_URL}
ENV NEXT_PUBLIC_SELF_HOSTED_DASHBOARD_URL=${NEXT_PUBLIC_SELF_HOSTED_DASHBOARD_URL}
RUN rush build -t dashboard-orchestrator
RUN rush-pnpm deploy --legacy --filter=dashboard-orchestrator --prod /tmp/deploy
# pnpm deploy strips gitignored paths (.next/ is in .gitignore), so the
# Next.js standalone output must be re-added explicitly. Dashboard-self-hosted
# happens to survive this strip; dashboard-orchestrator doesn't.
RUN cp -a /app/npm-packages/dashboard-orchestrator/.next /tmp/deploy/.next

FROM ubuntu:noble

# Install Node.js from NodeSource repository
# We extract the version from .nvmrc
COPY .nvmrc /nvmrc
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates
RUN <<EOF
# Extract major version (e.g., "18" from "18.x.x")
NODE_MAJOR=$(cat /nvmrc | cut -d. -f1 | tr -d 'v\n')
# Add NodeSource repository and its signing key
curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash -
# Install the specific version listed in the nvmrc file
NODE_VERSION=$(cat /nvmrc | tr -d 'v\n')
apt-get install -y --no-install-recommends nodejs=${NODE_VERSION}-1nodesource1
EOF

RUN groupadd --system --gid 1001 nodejs
RUN useradd --system --uid 1001 --gid nodejs nextjs
COPY --from=build --chown=nextjs:nodejs /tmp/deploy/ /app/
COPY --chmod=0755 self-hosted/docker-build/start-dashboard-orchestrator.sh /app/start.sh
WORKDIR /app
RUN cp /app/.next/standalone/server.js .
USER nextjs
EXPOSE 6793
ENV PORT=6793
ENV HOSTNAME=0.0.0.0
# start.sh rewrites NEXT_PUBLIC_* URLs baked into the client bundle to
# the operator-provided PUBLIC_* env vars before exec'ing the server,
# so non-localhost self-hosters don't have to rebuild the image.
CMD ["./start.sh"]
