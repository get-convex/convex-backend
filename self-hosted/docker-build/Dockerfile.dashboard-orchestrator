# syntax=docker/dockerfile:1-labs
# Builds dashboard-orchestrator (the platform UI: login, teams, projects,
# deployments, deploy keys). Mirrors Dockerfile.dashboard exactly except
# for the target package, port (6793), and the build-time NEXT_PUBLIC_*
# overrides.

FROM ubuntu:noble AS build

# Install deps
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates build-essential

# Install Node.js from NodeSource repository
# We extract the version from .nvmrc
COPY .nvmrc /nvmrc
RUN <<EOF
# Extract major version (e.g., "18" from "18.x.x")
NODE_MAJOR=$(cat /nvmrc | cut -d. -f1 | tr -d 'v\n')
# Add NodeSource repository and its signing key
curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash -
# Install the specific version listed in the nvmrc file
NODE_VERSION=$(cat /nvmrc | tr -d 'v\n')
apt-get install -y --no-install-recommends nodejs=${NODE_VERSION}-1nodesource1
EOF

WORKDIR /app
# pnpm/turbo come pinned from scripts/package-lock.json, so release builds
# always use the exact vetted versions.
COPY scripts ./scripts
RUN --mount=type=cache,target=/root/.npm npm ci --prefix scripts
ENV PATH="/app/scripts/node_modules/.bin:$PATH"
COPY ./npm-packages ./npm-packages
# Install dependencies and build
WORKDIR /app/npm-packages
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production
# Browser-facing URLs (orchestrator API etc.) are NOT baked at build
# time. They're injected into the page at request time by `_document.tsx`
# from server-side env (PUBLIC_ORCHESTRATOR_URL), so this image runs
# unchanged on any host.
RUN turbo run build --filter=dashboard-orchestrator...
RUN pnpm --filter=dashboard-orchestrator deploy --legacy --prod /tmp/deploy
# pnpm deploy strips gitignored paths (.next/ is in .gitignore), so the
# Next.js standalone output must be re-added explicitly. Dashboard-self-hosted
# happens to survive this strip; dashboard-orchestrator doesn't.
RUN cp -a /app/npm-packages/dashboard-orchestrator/.next /tmp/deploy/.next

FROM ubuntu:noble

# Install Node.js from NodeSource repository
# We extract the version from .nvmrc
COPY .nvmrc /nvmrc
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates
RUN <<EOF
# Extract major version (e.g., "18" from "18.x.x")
NODE_MAJOR=$(cat /nvmrc | cut -d. -f1 | tr -d 'v\n')
# Add NodeSource repository and its signing key
curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash -
# Install the specific version listed in the nvmrc file
NODE_VERSION=$(cat /nvmrc | tr -d 'v\n')
apt-get install -y --no-install-recommends nodejs=${NODE_VERSION}-1nodesource1
EOF

RUN groupadd --system --gid 1001 nodejs
RUN useradd --system --uid 1001 --gid nodejs nextjs
COPY --from=build --chown=nextjs:nodejs /tmp/deploy/ /app/
WORKDIR /app
RUN cp /app/.next/standalone/server.js .
USER nextjs
EXPOSE 6793
ENV PORT=6793
ENV HOSTNAME=0.0.0.0
CMD ["node", "./server.js"]
